{
  "name": "jev-client",
  "version": "1.0.0",
  "description": "CLI and library for the Jev (System One) API via OpenCode",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.9"
  },
  "bin": {
    "jev": "./dist/src/bin.js",
    "jev-mcp": "./dist/src/mcp-bin.js",
    "jev-client": "./dist/src/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "dist/web-console",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "npm run build && next build web && node scripts/build-console.mjs",
    "build:console": "npm run build:web",
    "typecheck": "npm run build && tsc -p web/tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js && npm run test:web",
    "test:web": "tsx --tsconfig web/tsconfig.json --conditions=react-server --test web/test/*.test.ts",
    "test:e2e": "npm run build:web && playwright test --config web/playwright.config.ts",
    "test:package": "node scripts/package-smoke.mjs",
    "start": "node dist/src/bin.js",
    "dev": "npm run build && node dist/src/bin.js",
    "mcp": "node dist/src/mcp-bin.js",
    "prepare": "npm run build:web",
    "prepack": "npm run build:web",
    "prepublishOnly": "npm test",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/src/bin.js', 0o755); require('node:fs').chmodSync('dist/src/mcp-bin.js', 0o755)\""
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^12.11.1",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "^3.25.76"
  }
}
